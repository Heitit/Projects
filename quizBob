<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quiz do Bob Esponja 🧽</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Comic Sans MS', 'Chalkboard SE', sans-serif;
    background: linear-gradient(180deg, #87CEEB 0%, #4FA8D8 50%, #1E6FA8 100%);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    overflow: hidden;
  }

  /* Bolhas decorativas */
  .bubble {
    position: fixed;
    bottom: -100px;
    background: rgba(255,255,255,0.4);
    border-radius: 50%;
    animation: subir 8s infinite linear;
    pointer-events: none;
  }
  @keyframes subir {
    0% { transform: translateY(0) scale(1); opacity: 0.7; }
    100% { transform: translateY(-120vh) scale(1.3); opacity: 0; }
  }

  .container {
    background: #FFE57F;
    border: 6px solid #8B4513;
    border-radius: 25px;
    padding: 35px 30px;
    max-width: 550px;
    width: 100%;
    box-shadow: 0 15px 35px rgba(0,0,0,0.3), inset 0 0 30px rgba(255,255,255,0.5);
    position: relative;
    z-index: 2;
    text-align: center;
  }

  h1 {
    color: #8B4513;
    font-size: 1.9em;
    margin-bottom: 20px;
    text-shadow: 2px 2px 0 #fff;
  }

  h2 {
    color: #C0392B;
    font-size: 1.4em;
    margin: 15px 0;
  }

  .pergunta {
    font-size: 1.25em;
    color: #2C3E50;
    margin-bottom: 25px;
    min-height: 60px;
    font-weight: bold;
  }

  input[type="text"] {
    width: 90%;
    padding: 14px;
    font-size: 1.1em;
    border: 3px solid #8B4513;
    border-radius: 12px;
    outline: none;
    font-family: inherit;
    text-align: center;
    background: #fff;
  }
  input[type="text"]:focus {
    border-color: #E74C3C;
    box-shadow: 0 0 12px rgba(231,76,60,0.5);
  }

  button {
    margin-top: 20px;
    padding: 14px 40px;
    font-size: 1.15em;
    font-weight: bold;
    background: linear-gradient(180deg, #FF6B6B, #C0392B);
    color: #fff;
    border: 3px solid #8B4513;
    border-radius: 15px;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 5px 0 #8B4513;
  }
  button:hover { transform: translateY(-2px); }
  button:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #8B4513;
  }

  .feedback {
    margin-top: 20px;
    font-size: 1.2em;
    font-weight: bold;
    min-height: 30px;
  }
  .acerto { color: #27AE60; }
  .erro { color: #C0392B; }

  .progresso {
    margin-top: 15px;
    font-size: 0.95em;
    color: #8B4513;
    font-weight: bold;
  }

  .emoji-grande { font-size: 3em; margin-bottom: 10px; }

  .resultado-item {
    background: #FFF3C4;
    border: 2px dashed #8B4513;
    border-radius: 12px;
    padding: 10px;
    margin: 10px 0;
    font-size: 1.1em;
    color: #2C3E50;
    font-weight: bold;
  }

  .hidden { display: none; }

  .barra-progresso {
    width: 100%;
    height: 14px;
    background: #fff;
    border: 2px solid #8B4513;
    border-radius: 10px;
    margin-top: 15px;
    overflow: hidden;
  }
  .barra-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #27AE60, #2ECC71);
    transition: width 0.4s;
  }
</style>
</head>
<body>

<div class="container">
  <!-- Tela Inicial -->
  <div id="tela-inicio">
    <div class="emoji-grande">🧽🍍</div>
    <h1>Quiz do Bob Esponja</h1>
    <p style="color:#2C3E50; margin: 15px 0; font-size:1.1em;">
      Você está pronto, criança?<br>
      Responda 5 perguntas sobre a Fenda do Biquíni!
    </p>
    <button onclick="iniciarQuiz()">Começar 🚀</button>
  </div>

  <!-- Tela de Pergunta -->
  <div id="tela-pergunta" class="hidden">
    <h2 id="titulo-pergunta">Pergunta 1 de 5</h2>
    <div class="pergunta" id="texto-pergunta"></div>
    <input type="text" id="input-resposta" placeholder="Digite sua resposta..." onkeypress="if(event.key==='Enter') responder()">
    <br>
    <button onclick="responder()">Responder</button>
    <div class="feedback" id="feedback"></div>
    <div class="progresso">
      <div class="barra-progresso">
        <div class="barra-fill" id="barra"></div>
      </div>
    </div>
  </div>

  <!-- Tela Final -->
  <div id="tela-final" class="hidden">
    <div class="emoji-grande">🏆</div>
    <h1>Fim do Quiz!</h1>
    <div class="resultado-item">✅ Acertos: <span id="res-acertos">0</span></div>
    <div class="resultado-item">❌ Erros: <span id="res-erros">0</span></div>
    <div class="resultado-item">⏱️ Tempo total: <span id="res-tempo">0</span> segundos</div>
    <div class="resultado-item">📊 Média de acertos: <span id="res-media">0</span></div>
    <div class="resultado-item">📝 Pontuação: <span id="res-pontos">0</span> / 5</div>
    <button onclick="reiniciarQuiz()">Jogar Novamente 🔁</button>
  </div>
</div>

<script>
  // ============ DADOS DO QUIZ ============
  const perguntas = [
    "Quem é o melhor amigo do Bob Esponja?",
    "Qual é o nome do caracol de estimação do Bob Esponja?",
    "Qual é o nome do restaurante onde o Bob Esponja trabalha?",
    "Quem é o vizinho ranzinza do Bob Esponja?",
    "Qual é a profissão do Bob Esponja no Siri Cascudo?"
  ];

  const respostas = [
    "Patrick",
    "Gary",
    "Siri Cascudo",
    "Lula Molusco",
    "Cozinheiro"
  ];

  // ============ ESTADO DO JOGO ============
  let indiceAtual = 0;
  let acertos = 0;
  let erros = 0;
  let tempoInicio = 0;

  // ============ ELEMENTOS ============
  const telaInicio = document.getElementById('tela-inicio');
  const telaPergunta = document.getElementById('tela-pergunta');
  const telaFinal = document.getElementById('tela-final');
  const tituloPergunta = document.getElementById('titulo-pergunta');
  const textoPergunta = document.getElementById('texto-pergunta');
  const inputResposta = document.getElementById('input-resposta');
  const feedback = document.getElementById('feedback');
  const barra = document.getElementById('barra');

  // ============ FUNÇÕES ============
  function iniciarQuiz() {
    indiceAtual = 0;
    acertos = 0;
    erros = 0;
    tempoInicio = Date.now();

    telaInicio.classList.add('hidden');
    telaFinal.classList.add('hidden');
    telaPergunta.classList.remove('hidden');

    mostrarPergunta();
  }

  function mostrarPergunta() {
    feedback.textContent = '';
    feedback.className = 'feedback';
    inputResposta.value = '';
    inputResposta.focus();

    tituloPergunta.textContent = `Pergunta ${indiceAtual + 1} de ${perguntas.length}`;
    textoPergunta.textContent = perguntas[indiceAtual];

    const pct = (indiceAtual / perguntas.length) * 100;
    barra.style.width = pct + '%';
  }

  function responder() {
    const respostaJogador = inputResposta.value.trim().toLowerCase();
    if (respostaJogador === '') {
      feedback.textContent = '⚠️ Digite uma resposta!';
      feedback.className = 'feedback erro';
      return;
    }

    const respostaCerta = respostas[indiceAtual].toLowerCase();

    if (respostaJogador === respostaCerta) {
      acertos++;
      feedback.textContent = '🎉 Você acertou!';
      feedback.className = 'feedback acerto';
    } else {
      erros++;
      feedback.textContent = `❌ Você errou! A resposta certa era: ${respostas[indiceAtual]}`;
      feedback.className = 'feedback erro';
    }

    // Desabilita input/button durante a transição
    inputResposta.disabled = true;

    // Aguarda 1.2s e vai para a próxima tela
    setTimeout(() => {
      inputResposta.disabled = false;
      indiceAtual++;
      if (indiceAtual < perguntas.length) {
        mostrarPergunta();
      } else {
        finalizarQuiz();
      }
    }, 1200);
  }

  function finalizarQuiz() {
    const tempoTotal = ((Date.now() - tempoInicio) / 1000).toFixed(2);

    telaPergunta.classList.add('hidden');
    telaFinal.classList.remove('hidden');

    document.getElementById('res-acertos').textContent = acertos;
    document.getElementById('res-erros').textContent = erros;
    document.getElementById('res-tempo').textContent = tempoTotal;
    document.getElementById('res-pontos').textContent = acertos;
    document.getElementById('res-media').textContent =
      (acertos / perguntas.length).toFixed(2);
  }

  function reiniciarQuiz() {
    iniciarQuiz();
  }

  // ============ BOLHAS DECORATIVAS ============
  function criarBolhas() {
    for (let i = 0; i < 15; i++) {
      const b = document.createElement('div');
      b.className = 'bubble';
      const tamanho = Math.random() * 60 + 20;
      b.style.width = tamanho + 'px';
      b.style.height = tamanho + 'px';
      b.style.left = Math.random() * 100 + 'vw';
      b.style.animationDuration = (Math.random() * 6 + 5) + 's';
      b.style.animationDelay = (Math.random() * 8) + 's';
      document.body.appendChild(b);
    }
  }
  criarBolhas();
</script>

</body>
</html>
